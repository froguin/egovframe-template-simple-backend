Resources:
  # ALB HTTPS:443 listener - Midway (Federate OIDC) authentication.
  AWSEBV2LoadBalancerListener443:
    Type: AWS::ElasticLoadBalancingV2::Listener
    Properties:
      DefaultActions:
        - Type: authenticate-oidc
          Order: 1
          AuthenticateOidcConfig:
            Issuer: https://idp.federate.amazon.com
            AuthorizationEndpoint: https://idp.federate.amazon.com/api/oauth2/v1/authorize
            TokenEndpoint: https://idp.federate.amazon.com/api/oauth2/v2/token
            UserInfoEndpoint: https://idp.federate.amazon.com/api/oauth2/v1/userinfo
            ClientId: egovframe-simple-backend-alb
            ClientSecret: '{{resolve:ssm-secure:/egovframe/backend/federate/client-secret:1}}'
            Scope: openid profile
            SessionCookieName: AWSELBAuthSessionCookie
            SessionTimeout: 28800
            OnUnauthenticatedRequest: authenticate
        - Type: forward
          Order: 2
          TargetGroupArn:
            Ref: AWSEBV2LoadBalancerTargetGroup

  # HTTPS egress so the ALB can reach the Federate token/userinfo endpoints
  # (idp.federate.amazon.com:443) during the authenticate-oidc code exchange.
  # Without this the /oauth2/idpresponse callback fails the upstream TLS
  # handshake and ALB returns HTTP 500. EB's LB security group only opens
  # tcp/80 egress by default, so we add 443 as a separate egress resource
  # (do NOT redefine the SG itself - EB manages it).
  MidwayAlbHttpsEgress:
    Type: AWS::EC2::SecurityGroupEgress
    Properties:
      GroupId:
        Ref: AWSEBLoadBalancerSecurityGroup
      IpProtocol: tcp
      FromPort: 443
      ToPort: 443
      CidrIp: 0.0.0.0/0
      Description: HTTPS outbound for ALB authenticate-oidc Federate token exchange
